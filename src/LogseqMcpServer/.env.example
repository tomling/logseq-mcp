# Logseq MCP Server Configuration

# Required: Authorization token from Logseq
# Find this in Logseq: Settings > Features > HTTP APIs server
LOGSEQ_AUTH_TOKEN=your-token-here

# Optional: Logseq HTTP API host (default: 127.0.0.1)
# Use "host.docker.internal" for Docker Desktop on macOS/Windows
# Use "172.17.0.1" or "--network host" for Linux
LOGSEQ_HOST=host.docker.internal

# Optional: Logseq HTTP API port (default: 12315)
LOGSEQ_PORT=12315
